{
  "manifest_version": 2,
  "name": "Anti ReelShorts Web",
  "version": "1.0",
  "description": "Hides YouTube Shorts.",
  "browser_specific_settings": {
    "gecko": {
      "id": "webbox@antireelshorts"
    }
  },
  "permissions": [
    "storage",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "css": [
        "hide.css"
      ],
      "js": [
        "content.js",
        "shorts.js",
        "player.js"
      ],
      "run_at": "document_start"
    }
  ]
}
